# All variables are optional. Copy to .env for local builds.

# Sub-path the app is served from, e.g. /my-repo/ for GitHub Pages project sites.
# Leave empty or set to / when the app is served from the domain root.
BASE_PATH=/

# --- Übungsdepot market data (public build-time values, they end up in the browser bundle) ---
# Leave empty to use the built-in fictional sample data ("Beispieldaten", default).
# Otherwise: URL of YOUR server-side proxy (see server/market-data-proxy). Never put an API key here.
VITE_MARKET_DATA_API_URL=
# Shown as "Datenquelle" in the app, e.g. "Twelve Data".
VITE_MARKET_DATA_PROVIDER_NAME=
VITE_MARKET_DATA_PROVIDER_URL=

# The vendor API key (TWELVE_DATA_API_KEY) belongs to the proxy only:
# set it as a platform secret or in server/.dev.vars – never in this file.
